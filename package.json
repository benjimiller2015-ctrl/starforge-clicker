{
  "name": "starforge-clicker",
  "version": "1.0.0",
  "private": true,
  "description": "A small stardust mining game built with plain JavaScript.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "format": "prettier --write dist/game.js \"*.{json,mjs,md}\" \"tests/*.mjs\"",
    "format:check": "prettier --check dist/game.js \"*.{json,mjs,md}\" \"tests/*.mjs\"",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10"
  }
}
